<IfModule mod_rewrite.c>
    RewriteEngine On

    # Security: Block sensitive files
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^composer\.(json|lock) - [F,L]
    RewriteRule ^vendor/ - [F,L]

    # Redirect all requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
